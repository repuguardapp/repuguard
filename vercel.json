{{
  "rewrites": [
    { "source": "/", "destination": "/repuguard-global.html" },
    { "source": "/signup", "destination": "/repuguard-signup.html" },
    { "source": "/dashboard", "destination": "/repuguard-dashboard.html" }
  ],  
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
