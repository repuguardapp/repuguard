# --- Supabase ---
# service_role key — server-side only, never exposed to the browser.
# The frontend never talks to Supabase directly; every call goes through /api/*.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- AI (reply drafting + translation) ---
ANTHROPIC_API_KEY=
ANTHROPIC_API_VERSION=2023-06-01

# --- Stripe Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Email (Resend) ---
RESEND_API_KEY=
# Inbox that receives /contact form submissions and newsletter admin notices.
ADMIN_EMAIL=

# --- Google Business Profile OAuth (reply publishing) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: https://repuguard.app/api/google-oauth-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 64 hex chars (32 bytes) — encrypts the GBP refresh token at rest (AES-256-GCM).
# Generate once with: openssl rand -hex 32 — store it, never rotate without
# re-authorizing every connected business.
TOKEN_ENCRYPTION_KEY=

# --- Review sources ---
GOOGLE_PLACES_API_KEY=
TRUSTPILOT_API_KEY=
TRIPADVISOR_API_KEY=

# --- Operational ---
# Bearer secret for /api/cron-sync and internal fetch-reviews calls.
# Vercel Cron sends it automatically as `Authorization: Bearer <CRON_SECRET>`
# once set as a project env var — see vercel.json's `crons` entry.
CRON_SECRET=
