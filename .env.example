# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Stripe Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Observability (Sentry) ---
# Public DSN — exposed to the client bundle, safe to commit at deploy time.
NEXT_PUBLIC_SENTRY_DSN=
# Server DSN — usually identical to the public one.
SENTRY_DSN=
# Used by withSentryConfig at build time to upload sourcemaps. Optional.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Operational ---
# Bearer secret for /api/cron/* endpoints. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`. Also accepted as ?secret=… for
# manual invocations during incidents.
CRON_SECRET=
# Days to keep audit + finding rows after creation (Privacy Policy).
AUDIT_RETENTION_DAYS=30
# Comma-separated list of emails allowed to access /admin/*.
ADMIN_EMAILS=
# Shared secret with the Supabase Auth Email Hook. Generated once and
# pasted into both Supabase and this env. See DEPLOY.md.
SUPABASE_AUTH_HOOK_SECRET=

# --- Bot protection (Cloudflare Turnstile) ---
# Both blank = captcha is a no-op on /api/auth/magic-link (dev-friendly
# default). Set both in Production to actually enforce it. Site key is
# public (ships in the client bundle); secret key stays server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=https://lexyflow.com
NEXT_PUBLIC_APP_NAME=LexyFlow
DEFAULT_LOCALE=en

# --- Document encryption (keyring) ---
# Documents are sealed with AES-256-GCM before they touch the database.
# A ciphertext records WHICH key sealed it, so the key can be rotated
# without making every stored document unreadable.
#
# Simplest form — one key, registered as id "v1":
DOCUMENT_ENCRYPTION_KEY=
#
# To rotate: hold both keys, point ACTIVE at the new one, deploy. New
# documents seal under v2; old ones still open under v1 and re-seal
# under v2 the next time they are read. When
#   select count(*) from audits
#    where document_ciphertext is not null
#      and coalesce(document_key_id,'v1') <> 'v2';
# reaches zero, drop v1 and the old key is dead.
# DOCUMENT_ENCRYPTION_KEYS=v1:<base64>,v2:<base64>
# DOCUMENT_ENCRYPTION_ACTIVE=v2
#
# Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Resend delivery events ---
# Signing secret for the bounce/complaint webhook, from Resend →
# Webhooks → Add endpoint → https://lexyflow.com/api/resend-webhook,
# subscribed to email.bounced and email.complained. Without it the
# endpoint answers 503 and the suppression list never fills, so a hard
# bounce changes nothing and we keep writing to a dead mailbox.
RESEND_WEBHOOK_SECRET=
