{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --no-audit --no-fund",
  "regions": ["cdg1"],
  "functions": {
    "src/app/api/reviews/route.ts":            { "maxDuration": 60,  "memory": 512 },
    "src/app/api/cron/sync/route.ts":          { "maxDuration": 120, "memory": 512 },
    "src/app/api/responses/generate/route.ts": { "maxDuration": 30,  "memory": 512 },
    "src/app/api/checkout/route.ts":           { "maxDuration": 30,  "memory": 512 },
    "src/app/api/stripe-webhook/route.ts":     { "maxDuration": 30,  "memory": 512 }
  },
  "crons": [
    { "path": "/api/cron/sync", "schedule": "0 */6 * * *" }
  ],
  "headers": [
    {
      "source": "/((?!embed/).*)",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
